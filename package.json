{
  "name": "quality-gate-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only tooling for this repo's own build steps. Never copied into target projects by qg-init (see $folders in scripts/QualityGate.ps1) — target projects keep receiving loose files only, no package.json, no node_modules.",
  "scripts": {
    "build:tui": "node scripts/build-tui.mjs",
    "format": "prettier --write --no-error-on-unmatched-pattern scripts test",
    "format:check": "prettier --check --no-error-on-unmatched-pattern scripts test",
    "lint": "eslint scripts test --max-warnings=0 --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "ink": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "^19.2.0"
  },
  "optionalDependencies": {
    "oxc-parser": "0.154.0"
  }
}
