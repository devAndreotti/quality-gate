{
  "schemaVersion": 1,
  "profile": "strict-node",
  "project": {
    "surfaces": [
      {
        "type": "node",
        "root": ".",
        "required": false
      }
    ]
  },
  "ci": {
    "requiredChecks": [
      "Security audit",
      "Lint",
      "Tests & ratchet",
      "Docker image gate"
    ],
    "advisoryChecks": [
      "SonarCloud",
      "SonarCloud Code Analysis"
    ],
    "coverageRatchet": true,
    "maxFileLines": 300,
    "architectureBoundary": {
      "enabled": false,
      "blockOnFailure": true,
      "rules": []
    },
    "aiEvals": {
      "enabled": false,
      "minScore": 0.85,
      "blockOnFailure": true
    },
    "diffCoverage": {
      "enabled": true,
      "minPercentage": 90,
      "blockOnFailure": false
    },
    "prSize": {
      "enabled": false,
      "maxChangedLines": 800,
      "blockOnFailure": false
    }
  },
  "bootstrap": {
    "license": {
      "enabled": true,
      "type": "MIT"
    },
    "funding": {
      "enabled": true,
      "buyMeACoffee": "ricardo230a"
    },
    "dependabot": {
      "enabled": true
    },
    "readme": {
      "enabled": true,
      "style": "devandreotti"
    }
  },
  "github": {
    "copilotReview": true,
    "branchProtection": true,
    "requireConversationResolution": true
  },
  "dockerImageDoctor": {
    "enabled": "auto",
    "runWhen": "docker-files-present",
    "scriptPath": "C:\\tools\\18-Docker-Image-Doctor.ps1",
    "agentArgs": [
      "-Preset",
      "AI",
      "-ForAI",
      "-Json",
      "-FixPlan",
      "-NoPrompt"
    ],
    "interactiveAllowed": false,
    "blockOn": [
      "Critical"
    ],
    "warnOn": [
      "High",
      "Medium"
    ],
    "fallbackWhenUnavailable": "static-advisory"
  },
  "localValidation": {
    "untrackedAllowlist": [
      "samples/**"
    ],
    "pytestBasetempPattern": ".pytest-tmp-qg-${timestamp}-${pid}"
  }
}
